# Base de données MySQL
DB_ROOT_PASSWORD=changeme-root-password
DB_NAME=quiz
DB_USER=quiz
DB_PASSWORD=changeme-db-password

# Secret utilisé pour signer les jetons Mercure (temps réel)
MERCURE_JWT_SECRET=changeme-mercure-secret-at-least-32-chars

# Ports exposés sur l'hôte
BACKEND_PORT=8080
FRONTEND_PORT=8081
MERCURE_PORT=3000
ADMINER_PORT=8082

# URLs publiques (celles que les navigateurs des joueurs utiliseront)
# À adapter avec l'IP/domaine du serveur le jour du séminaire.
FRONTEND_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:8080
PUBLIC_MERCURE_URL=http://localhost:3000/.well-known/mercure
